# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo

# MCP Server Configuration
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8000
MCP_SERVER_URL=your-ngrok-url/mcp
MCP_SERVER_NAME=booking-mcp

# Database Configuration
DATABASE_PATH=resources/bookings.sqlite
DATABASE_POOL_SIZE=5
DATABASE_ECHO=false
HOLIDAYS_JSON=resources/holidays.json

# Google Calendar Configuration (opcional)
# Deja vacío si no quieres usar Google Calendar
GOOGLE_CALENDAR_ENABLED=true
GOOGLE_CALENDAR_ID=primary
GOOGLE_CREDENTIALS_PATH=resources/google_credentials.json
GOOGLE_TOKEN_PATH=resources/google_token.json

# Application Configuration
APP_NAME=AI Booking System
APP_VERSION=2.0.0
DEBUG=false
LOG_LEVEL=INFO

# Business Rules
MIN_BOOKING_DURATION_MINUTES=60
MAX_BOOKING_DURATION_MINUTES=180
EXTRA_TIME_PER_GUEST_MINUTES=15
LATE_DINNER_HOUR_THRESHOLD=21
LATE_DINNER_EXTRA_MINUTES=30
OPEN_TIME=09:00
CLOSE_TIME=00:00
